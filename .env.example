# บ้านกาญจน์ — environment variables.
# Copy to .env and fill in real values. Production deploys must set every
# REQUIRED entry — server.js refuses to boot otherwise.

# === REQUIRED in production ==============================================
# Postgres URL. On Railway, use the Postgres service's DATABASE_URL
# reference. If services are in different projects, copy DATABASE_PUBLIC_URL.
DATABASE_URL=postgresql://user:pass@host:5432/db

# Session signing secret. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
# Must be ≥ 32 chars. Rotating this secret invalidates every existing session.
SESSION_SECRET=change-me-to-a-long-random-string

# First admin's password. Used at boot to seed auth_users if it's empty.
# Must be ≥ 12 chars in production. Set SKIP_ADMIN_BOOTSTRAP=1 if you
# manage users via the API yourself.
ADMIN_PASSWORD=at-least-twelve-characters
ADMIN_USERNAME=admin

# === Optional (feature-flagged) ==========================================
NODE_ENV=production
PORT=3000

# Diagnostics/staging: run HTTP/API without hourly scheduler, audit pruner,
# bill auto-generation, or notification queue dispatch.
DISABLE_BACKGROUND_JOBS=0

# AES-256-GCM key for citizen-ID encryption. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required when the citizenIdEncryption feature flag is on (default: on).
# Versioned form (preferred) — supports key rotation without data loss:
#   ENCRYPTION_KEY_V1=...
#   ENCRYPTION_KEY_V2=...
#   ENCRYPTION_KEY_CURRENT=2
# Legacy single-key form (still supported):
#   CITIZEN_ID_KEY=...
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_CURRENT=1

# CSRF secret for csrf-csrf double-submit cookie (when wired in).
CSRF_SECRET=

# PromptPay target for bill QR codes (Thai phone or 13-digit citizen ID).
PROMPTPAY_TARGET=

# LINE Messaging API
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_OWNER_USER_ID=

# Email (SMTP) — when the email feature flag is on
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
OWNER_EMAIL=

# Sentry (error tracking) — when the errorTracking feature flag is on
SENTRY_DSN=

# Cloudflare R2 / S3 backup target — when the autoBackup feature flag is on
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_BUCKET=

# File uploads — point at a Railway volume so files survive restarts
UPLOAD_DIR=

# Limits
MAX_UPLOAD_SIZE=5242880    # 5 MB
